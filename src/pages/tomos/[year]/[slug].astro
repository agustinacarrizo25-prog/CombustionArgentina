---
import { getCollection } from 'astro:content';
import CombustionArgentinaVol1 from '@components/tomos/vol001/CombustionArgentinaVol1.astro';

export async function getStaticPaths() {
  const tomos = await getCollection('tomos');

  return tomos.map((tomo) => ({
    params: {
      year: String(tomo.data.year),
      slug: tomo.data.slug,
    },
    props: { tomo },
  }));
}

const { tomo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={tomo.data.summary} />
    <title>{tomo.data.volumeLabel} · {tomo.data.title} | Combustión Argentina</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <CombustionArgentinaVol1 />
  </body>
</html>
