    background: var(--celeste);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s;
  }
  .sp-card:hover::after { transform: scaleX(1); }
  .sp-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 15px; letter-spacing: 1px; color: var(--blanco); margin-bottom: 2px;
  }
  .sp-tipo {
    font-size: 8px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--dorado); margin-bottom: 6px;
  }
  .sp-desc { font-size: 9.5px; line-height: 1.5; color: rgba(245,242,237,0.55); }

  /* Comparison panel (Williams/Alpine) */
  .comp-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--gris-medio);
    margin: 10px 0;
  }
  .comp-panel {
    background: var(--gris);
    padding: 14px 12px 12px;
    position: relative;
    overflow: hidden;
  }
  .comp-panel-left { border-right: 2px solid #005AFF; }
  .comp-accent-bar {
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
  }
  .comp-team {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 16px; letter-spacing: 2px; margin-bottom: 10px; margin-top: 4px;
  }
  .comp-row-sm {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 0; border-bottom: 1px solid var(--gris-medio); gap: 4px;
  }
  .comp-row-sm:last-child { border-bottom: none; }
  .comp-metric { font-size: 8px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gris-claro); flex-shrink: 0; min-width: 60px; }
  .comp-vals { display: flex; align-items: center; gap: 4px; font-family: 'Bebas Neue', sans-serif; }
  .comp-before { font-size: 12px; color: rgba(245,242,237,0.4); }
  .comp-after { font-size: 14px; color: var(--dorado); }
  .comp-badge { font-size: 9px; padding: 2px 5px; font-weight: 700; white-space: nowrap; font-family: 'DM Sans', sans-serif; }
  .comp-note {
    margin-top: 8px; padding: 8px; font-size: 9px; line-height: 1.5;
    color: rgba(245,242,237,0.65); border: 1px solid;
  }
  .comp-note strong { color: var(--blanco); }

  /* Probability bars */
  .prob-container { margin: 10px 0; }
  .prob-row { margin-bottom: 10px; }
  .prob-head { display: flex; justify-content: space-between; margin-bottom: 4px; }
  .prob-name { font-size: 10px; font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; color: var(--blanco); }
  .prob-pct {
    font-family: 'Bebas Neue', sans-serif; font-size: 15px; color: var(--dorado);
  }
  .prob-track { height: 5px; background: var(--gris-medio); overflow: hidden; }
  .prob-fill { height: 100%; background: linear-gradient(90deg, var(--celeste-oscuro), var(--celeste)); }

  /* Cards grid 2x2 */
  .cards-2x2 {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 10px 0;
  }
  .obstacle-card {
    border: 1px solid var(--gris-medio); padding: 10px 12px;
    transition: border-color 0.3s;
  }
  .obstacle-card:hover { border-color: var(--dorado); }
  .tag-pos {
    display: inline-block;
    background: rgba(0,120,0,0.2); border: 1px solid rgba(0,180,0,0.3);
    color: #5fca5f; font-size: 7.5px; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; padding: 2px 6px; margin-bottom: 6px;
  }
  .tag-chal {
    display: inline-block;
    background: rgba(120,80,0,0.2); border: 1px solid rgba(200,168,75,0.3);
    color: var(--dorado); font-size: 7.5px; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; padding: 2px 6px; margin-bottom: 6px;
  }
  .obstacle-title { font-family: 'Bebas Neue', sans-serif; font-size: 13px; letter-spacing: 1px; margin-bottom: 4px; }
  .obstacle-desc { font-size: 9.5px; color: rgba(245,242,237,0.6); line-height: 1.5; }

  /* Obras list */
  .obras-list { list-style: none; margin: 10px 0; }
  .obra-item { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--gris-medio); align-items: flex-start; }
  .obra-icon {
    width: 24px; height: 24px; background: var(--celeste);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; flex-shrink: 0; font-weight: 700;
    font-family: 'Bebas Neue', sans-serif; color: var(--negro);
  }
  .obra-txt { font-size: 10px; line-height: 1.5; color: rgba(245,242,237,0.7); }
  .obra-txt strong { color: var(--blanco); }

  /* Fases */
  .fases-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin: 10px 0; }
  .fase-card { background: var(--gris); padding: 14px; position: relative; }
  .fase-n {
    font-family: 'Bebas Neue', sans-serif; font-size: 48px;
    color: rgba(116,172,223,0.12); position: absolute; top: 4px; right: 8px; line-height: 1;
  }
  .fase-title { font-family: 'Bebas Neue', sans-serif; font-size: 14px; letter-spacing: 2px; color: var(--dorado); margin-bottom: 6px; }
  .fase-desc { font-size: 10px; color: rgba(245,242,237,0.65); line-height: 1.55; }

  /* Impacto card */
  .impacto-card {
    background: linear-gradient(135deg, #8b6a1a, var(--dorado));
    padding: 20px 18px; position: relative; overflow: hidden; margin-bottom: 2px;
  }
  .impacto-card::before {
    content: '$'; font-family: 'Bebas Neue', sans-serif; font-size: 120px;
    color: rgba(255,255,255,0.08); position: absolute; right: -10px; bottom: -20px; line-height: 1;
  }
  .impacto-monto { font-family: 'Bebas Neue', sans-serif; font-size: 52px; color: var(--blanco); line-height: 1; display: block; }
  .impacto-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.7); display: block; margin-bottom: 8px; }
  .impacto-desc { font-size: 10px; color: rgba(255,255,255,0.85); line-height: 1.5; position: relative; z-index: 1; }

  /* Data table */
  .data-table { background: var(--gris); padding: 14px; }
  .data-row {
    display: flex; justify-content: space-between;
    padding: 6px 0; border-bottom: 1px solid var(--gris-medio); font-size: 10px;
  }
  .data-row:last-child { border-bottom: none; }
  .data-label { color: rgba(245,242,237,0.55); }
  .data-val { font-weight: 500; }

  /* MotoGP callout */
  .motogp-callout {
    background: rgba(200,168,75,0.08); border: 1px solid rgba(200,168,75,0.3);
    padding: 12px 14px; margin-top: 8px;
  }
  .callout-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--dorado); margin-bottom: 6px; }
  .callout-txt { font-size: 10px; color: rgba(245,242,237,0.75); line-height: 1.5; }

  /* Horizon box */
  .horizon-box { background: var(--gris); padding: 20px; margin-top: 14px; position: relative; overflow: hidden; }
  .horizon-year {
    position: absolute; right: -8px; bottom: -8px;
    font-family: 'Bebas Neue', sans-serif; font-size: 80px;
    color: rgba(116,172,223,0.08); line-height: 1;
  }
  .horizon-label { font-family: 'Bebas Neue', sans-serif; font-size: 10px; letter-spacing: 3px; color: var(--celeste); margin-bottom: 8px; }
  .horizon-quote {
    font-family: 'DM Serif Display', serif; font-style: italic;
    font-size: 13px; line-height: 1.5; color: var(--blanco); margin-bottom: 8px; position: relative; z-index: 1;
  }
  .horizon-txt { font-size: 10px; line-height: 1.7; color: rgba(245,242,237,0.7); position: relative; z-index: 1; }

  /* Context box */
  .context-box { background: var(--gris); padding: 16px; margin-top: 12px; }
  .context-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--dorado); margin-bottom: 8px; }

  /* Ticker band */
  .ticker-band {
    width: 100%;
    background: linear-gradient(90deg, var(--celeste-oscuro), var(--celeste));
    padding: 8px 0;
    overflow: hidden; white-space: nowrap;
  }
  .ticker-inner {
    display: inline-block;
    animation: ticker 25s linear infinite;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px; letter-spacing: 3px; color: var(--negro);
  }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Divider line with label */
  .divider-label-line {
    display: flex; align-items: center; gap: 10px; margin: 12px 0;
  }
  .divider-label-line::before, .divider-label-line::after {
    content: ''; flex: 1; height: 1px; background: var(--gris-medio);
  }
  .div-label { font-size: 8px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gris-claro); white-space: nowrap; }

  /* ===========================
     PAGE-SPECIFIC LAYOUTS
  =========================== */

  /* === PORTADA (p1) === */
  .portada {
    background: var(--negro);
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .portada-foto {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.84) 0%, rgba(0,0,0,0.62) 48%, rgba(0,0,0,0.22) 100%),
      linear-gradient(180deg, rgba(0,0,0,0.08) 45%, rgba(0,0,0,0.8) 100%),
      url('/img/portada.webp') center center / cover no-repeat;
  }
  .portada-sol-anterior { display: none; }
  .portada-band-top {
    height: 5px;
    background: linear-gradient(90deg, var(--celeste) 33%, #fff 33%, #fff 66%, var(--celeste) 66%);
    opacity: 0.7;
  }
  .portada-grid {
    flex: 1; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden;
  }
  .portada-izq {
    padding: 32px 28px; display: flex; flex-direction: column; justify-content: space-between;
    position: relative; z-index: 2;
  }
  .portada-izq::after {
    content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 1px;
    background: linear-gradient(to bottom, transparent, var(--celeste), transparent);
  }
  .portada-eyebrow {
    font-size: 8px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase;
    color: var(--celeste); display: flex; align-items: center; gap: 8px;
  }
  .portada-eyebrow::before { content: ''; display: block; width: 20px; height: 1px; background: var(--celeste); }
  .portada-titulo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 80px; line-height: 0.88; letter-spacing: 2px; color: var(--blanco);
  }
  .portada-titulo span { color: var(--celeste); display: block; }
  .portada-sub {
    font-family: 'DM Serif Display', serif; font-style: italic;
    font-size: 13px; color: var(--gris-claro); line-height: 1.5; max-width: 220px;
  }
  .portada-cta {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--celeste); color: var(--negro);
    padding: 8px 16px; font-size: 9px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase; width: fit-content;
  }
  .portada-der {
    background: var(--gris); position: relative; overflow: hidden;
  }
  .portada-der-pattern {
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(90deg, transparent, transparent 40px, rgba(116,172,223,0.04) 40px, rgba(116,172,223,0.04) 41px),
      repeating-linear-gradient(0deg, transparent, transparent 40px, rgba(116,172,223,0.04) 40px, rgba(116,172,223,0.04) 41px);
  }
  .portada-stats {
    position: absolute; inset: 0;
    display: grid; grid-template-rows: 1fr 1fr;
  }
  .portada-stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; }
  .portada-stat-item {
    background: rgba(10,10,10,0.65);
    display: flex; flex-direction: column; justify-content: center;
    padding: 24px; position: relative; overflow: hidden;
    transition: background 0.3s;
  }
  .portada-stat-item:hover { background: rgba(10,20,35,0.9); }
  .portada-stat-item::before {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 3px; height: 0; background: var(--dorado); transition: height 0.4s;
  }
  .portada-stat-item:hover::before { height: 100%; }
  .p-stat-n { font-family: 'Bebas Neue', sans-serif; font-size: 42px; color: var(--dorado); line-height: 1; margin-bottom: 4px; }
  .p-stat-l { font-size: 8px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gris-claro); line-height: 1.3; }
  .portada-ghost {
    position: absolute; bottom: -10px; left: -10px;
    font-family: 'Bebas Neue', sans-serif; font-size: 140px;
    color: rgba(116,172,223,0.04); line-height: 1; pointer-events: none; z-index: 0;
  }
  .portada-bottom {
    height: 44px; background: rgba(5,5,5,0.9);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 20px;
  }
  .portada-bottom-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 16px; letter-spacing: 3px; color: var(--dorado);
  }
  .portada-bottom-info { font-size: 9px; letter-spacing: 1.5px; color: rgba(245,242,237,0.35); }

  /* === LEGALES (p2) === */
  .legales-page {
    width: 100%; height: 100%;
    background: var(--negro);
    display: flex; flex-direction: column;
    padding: 40px 32px 32px;
    position: relative; overflow: hidden;
  }
  .legales-page::before {
    content: 'VR'; font-family: 'Bebas Neue', sans-serif; font-size: 240px;
    color: rgba(116,172,223,0.03); position: absolute; bottom: -20px; right: -20px; line-height: 1;
  }
  .leg-titulo {
    font-family: 'Bebas Neue', sans-serif; font-size: 36px; letter-spacing: 3px; color: var(--blanco); margin-bottom: 4px;
  }
  .leg-subtitulo {
    font-family: 'DM Serif Display', serif; font-style: italic;
    font-size: 12px; color: var(--gris-claro); margin-bottom: 24px; line-height: 1.5;
  }
  .leg-rule { width: 40px; height: 2px; background: var(--celeste); margin-bottom: 24px; }
  .leg-block { margin-bottom: 18px; }
  .leg-label { font-size: 8px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--celeste); margin-bottom: 5px; }
  .leg-txt { font-size: 10px; line-height: 1.65; color: rgba(245,242,237,0.55); }
  .leg-txt strong { color: rgba(245,242,237,0.8); }
  .leg-indice { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--gris-medio); }
  .leg-indice-titulo { font-size: 8px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--dorado); margin-bottom: 10px; }
  .leg-indice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
  .leg-indice-item { display: flex; align-items: baseline; gap: 6px; font-size: 9.5px; }
  .leg-indice-num { font-family: 'Bebas Neue', sans-serif; font-size: 13px; color: var(--celeste); flex-shrink: 0; }
  .leg-indice-name { color: rgba(245,242,237,0.65); }

  /* === CIERRE page === */
  .cierre-page {
    width: 100%; height: 100%; position: relative; overflow: hidden;
    background: linear-gradient(180deg, #0d0d0d 0%, #1a2d42 60%, #0d1e2e 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 32px;
  }
  .cierre-page::before {
    content: 'ARGENTINA'; font-family: 'Bebas Neue', sans-serif; font-size: 160px;
    color: rgba(255,255,255,0.025); position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); white-space: nowrap; pointer-events: none; line-height: 1;
  }
  .cierre-bandera { display: flex; width: 56px; height: 3px; margin: 0 auto 20px; }
  .bf-c { flex: 1; background: #74acdf; }
  .bf-b { flex: 1; background: #fff; }
  .cierre-titulo {
    font-family: 'Bebas Neue', sans-serif; font-size: 60px; line-height: 0.92;
    margin-bottom: 16px; position: relative; z-index: 1;
  }
  .cierre-sub {
    font-family: 'DM Serif Display', serif; font-style: italic;
    font-size: 14px; color: rgba(245,242,237,0.8); max-width: 360px;
    margin: 0 auto 24px; line-height: 1.5; position: relative; z-index: 1;
  }
  .cierre-edition {
    font-family: 'Bebas Neue', sans-serif; font-size: 11px; letter-spacing: 3px;
    color: rgba(245,242,237,0.35); position: relative; z-index: 1;
  }

  /* === FOOTER page === */
  .footer-page {
    width: 100%; height: 100%; background: var(--negro);
    display: flex; flex-direction: column; padding: 36px 32px;
    border-top: 1px solid var(--gris-medio);
  }
  .fp-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 36px; letter-spacing: 5px; color: var(--dorado);
    margin-bottom: 6px;
  }
  .fp-tagline {
    font-family: 'DM Serif Display', serif; font-style: italic;
    font-size: 12px; color: rgba(245,242,237,0.5); line-height: 1.6; max-width: 280px; margin-bottom: 20px;
  }
  .fp-divider { height: 1px; background: var(--gris-medio); margin-bottom: 20px; }
  .fp-indice-label {
    font-size: 8.5px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--celeste); margin-bottom: 12px;
  }
  .fp-indice { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .fp-indice li { font-size: 11.5px; color: rgba(245,242,237,0.55); display: flex; align-items: center; gap: 8px; }
  .fp-indice li::before { content: ''; display: block; width: 12px; height: 1px; background: var(--dorado); flex-shrink: 0; }
  .fp-sources { margin-top: auto; font-size: 8px; letter-spacing: 1px; color: rgba(245,242,237,0.25); line-height: 1.6; }

  /* ===========================
     EDITORIAL REDESIGN PASS
     Visual direction: racing magazine, image-led spreads, stronger hierarchy.
  =========================== */
  :root {
    --rojo-f1: #e10600;
    --papel: #f4f0e8;
    --tinta: #101010;
  }

  .toolbar {
    background: rgba(8,8,8,0.98);
    border-bottom: 2px solid var(--rojo-f1);
  }
  .toolbar-logo { color: var(--blanco); }
  .toolbar-logo::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 8px;
    margin-right: 8px;
    background: var(--rojo-f1);
    transform: skewX(-18deg);
  }

  .stage {
    background:
      radial-gradient(circle at 50% 0%, rgba(225,6,0,0.16), transparent 28%),
      linear-gradient(180deg, #151515 0%, #070707 100%);
  }

  .spread {
    box-shadow:
      -16px 8px 44px rgba(0,0,0,0.82),
      16px 8px 44px rgba(0,0,0,0.82),
      0 26px 70px rgba(0,0,0,0.62);
  }

  .page {
    background: var(--papel);
    color: var(--tinta);
  }

  .page-content {
    inset: 30px 28px 34px;
  }

  #spread-0 .page,
  #spread-6 .page {
    background: var(--negro);
    color: var(--blanco);
  }

  .sec-tag {
    color: var(--rojo-f1);
    letter-spacing: 3px;
    margin-bottom: 8px;
  }

  .sec-title {
    color: var(--tinta);
    font-size: 52px;
    line-height: 0.84;
    letter-spacing: 0;
    max-width: 360px;
  }

  .sec-rule {
    width: 64px;
    height: 5px;
    background: var(--rojo-f1);
    transform: skewX(-18deg);
    margin: 12px 0 18px;
  }

  .lead {
    color: #222;
    font-size: 14px;
    line-height: 1.5;
  }

  .body-txt,
  .tl-desc,
  .sp-desc,
  .fase-desc,
  .obra-txt,
  .callout-txt,
  .horizon-txt,
  .horizon-quote,
  .prob-name,
  .obstacle-desc {
    color: rgba(16,16,16,0.72);
  }

  .body-txt strong,
  .obra-txt strong {
    color: var(--tinta);
  }

  .running-head,
  .page-num {
    color: rgba(16,16,16,0.34);
  }

  #spread-0 .running-head,
  #spread-0 .page-num,
  #spread-6 .page-num {
    color: rgba(245,242,237,0.42);
  }

  .quote-block,
  .stat-box,
  .sp-card,
  .comp-panel,
  .fase-card,
  .data-table,
  .horizon-box,
  .context-box,
  .obstacle-card {
    background: #ffffff;
    border: 1px solid rgba(16,16,16,0.11);
    box-shadow: 0 10px 22px rgba(0,0,0,0.07);
  }

  .quote-block {
    border-left: 6px solid var(--rojo-f1);
  }

  .quote-text {
    color: var(--tinta);
    font-size: 13px;
  }

  .quote-src,
  .stat-l,
  .div-label,
  .data-label {
    color: rgba(16,16,16,0.48);
  }

  .stat-n,
  .tl-year,
  .p-stat-n,
  .prob-pct,
  .impacto-monto {
    color: var(--rojo-f1);
  }

  .timeline::before {
    background: linear-gradient(to bottom, var(--rojo-f1), rgba(225,6,0,0));
  }

  .tl-dot,
  .prob-fill {
    background: var(--rojo-f1);
  }

  .prob-track {
    background: rgba(16,16,16,0.16);
  }

  .divider-label-line::before,
  .divider-label-line::after,
  .data-row,
  .obra-item,
  .comp-row-sm {
    border-color: rgba(16,16,16,0.12);
  }

  .photo-slot {
    position: relative;
    min-height: 168px;
    overflow: hidden;
    background:
