  }
  .lead {
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.55;
    color: var(--blanco);
    margin-bottom: 12px;
  }
  .body-txt {
    font-size: 11px;
    line-height: 1.75;
    color: rgba(245,242,237,0.72);
    margin-bottom: 10px;
  }
  .body-txt strong { color: var(--blanco); }

  /* Quote block */
  .quote-block {
    background: var(--gris);
    border-left: 3px solid var(--celeste);
    padding: 14px 16px;
    margin: 12px 0;
    position: relative;
  }
  .quote-text {
    font-family: 'DM Serif Display', serif;
