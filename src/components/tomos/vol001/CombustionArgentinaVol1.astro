<script is:inline>

  const spreads = document.querySelectorAll('.spread-container');
  const totalSpreads = spreads.length;
  let current = 0;
  let animating = false;

  const pageLabels = [
    'PÁG 1', 'PÁGS 2–3', 'PÁGS 4–5', 'PÁGS 6–7',
    'PÁGS 8–9', 'PÁGS 10–11', 'PÁG 12'
  ];

  function goToSpread(index, direction) {
    if (animating) return;
    if (index < 0 || index >= totalSpreads || index === current) return;
    animating = true;

    const dir = direction !== undefined ? direction : (index > current ? 1 : -1);
    const outClass = dir > 0 ? 'anim-out-right' : 'anim-out-left';
    const inClass  = dir > 0 ? 'anim-in-right'  : 'anim-in-left';

    const outEl = spreads[current];
    const inEl  = spreads[index];

    // Animate out current
    outEl.classList.add(outClass);

    setTimeout(() => {
      outEl.classList.remove('active', outClass);
      current = index;

      inEl.classList.add('active', inClass);
      document.getElementById('page-indicator').textContent = pageLabels[current];
      document.getElementById('btn-prev').disabled = current === 0;
      document.getElementById('btn-next').disabled = current === totalSpreads - 1;
      window.scrollTo({ top: 0, behavior: 'smooth' });

      setTimeout(() => {
        inEl.classList.remove(inClass);
        animating = false;
      }, 440);
    }, 290);
  }

  const mobileQuery = window.matchMedia('(max-width: 599px)');
  const mobilePages = [...document.querySelectorAll('.spread-container .page')];
  const spreadWrapper = document.querySelector('.spread-wrapper');
  let mobileCurrent = 0;

  function sizeMobilePage() {
    const width = mobilePages[mobileCurrent].closest('.spread.single') ? 610 : 520;
    spreadWrapper.style.setProperty('--mobile-page-width', `${width}px`);
    spreadWrapper.style.setProperty('--mobile-page-scale', Math.min(1, (window.innerWidth - 28) / width));
  }

  function goToMobilePage(index) {
    if (index < 0 || index >= mobilePages.length || index === mobileCurrent) return;
    mobilePages[mobileCurrent].classList.remove('mobile-visible');
    mobilePages[mobileCurrent].closest('.spread-container').classList.remove('active');
    mobileCurrent = index;
    mobilePages[mobileCurrent].closest('.spread-container').classList.add('active');
    mobilePages[mobileCurrent].classList.add('mobile-visible');
    sizeMobilePage();
    document.getElementById('page-indicator').textContent = `PÁG ${index + 1} / ${mobilePages.length}`;
    document.getElementById('btn-prev').disabled = index === 0;
    document.getElementById('btn-next').disabled = index === mobilePages.length - 1;
    window.scrollTo(0, 0);
  }

  function prevSpread() {
    if (mobileQuery.matches) goToMobilePage(mobileCurrent - 1);
    else goToSpread(current - 1, -1);
  }
  function nextSpread() {
    if (mobileQuery.matches) goToMobilePage(mobileCurrent + 1);
    else goToSpread(current + 1, 1);
  }

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  nextSpread();
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')    prevSpread();
  });

  // Click on spread halves
  document.querySelector('.spread-wrapper').addEventListener('click', (e) => {
    if (mobileQuery.matches) { nextSpread(); return; }
    const wrapper = document.querySelector('.spread-wrapper');
    const rect = wrapper.getBoundingClientRect();
    const midX = rect.left + rect.width / 2;
    if (e.clientX > midX) nextSpread();
    else                   prevSpread();
  });

  // Touch / swipe
  let touchStartX = 0;
  document.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 60) dx < 0 ? nextSpread() : prevSpread();
  }, { passive: true });

  document.addEventListener('DOMContentLoaded', () => {
    mobilePages[0].classList.add('mobile-visible');
    sizeMobilePage();
    mobileQuery.addEventListener('change', () => {
      if (mobileQuery.matches) {
        spreads.forEach(spread => spread.classList.remove('active'));
        mobilePages[mobileCurrent].closest('.spread-container').classList.add('active');
        sizeMobilePage();
        document.getElementById('page-indicator').textContent = `PÁG ${mobileCurrent + 1} / ${mobilePages.length}`;
        document.getElementById('btn-prev').disabled = mobileCurrent === 0;
        document.getElementById('btn-next').disabled = mobileCurrent === mobilePages.length - 1;
      } else {
        spreads.forEach(spread => spread.classList.remove('active'));
        current = [...spreads].indexOf(mobilePages[mobileCurrent].closest('.spread-container'));
        spreads[current].classList.add('active');
        document.getElementById('page-indicator').textContent = pageLabels[current];
        document.getElementById('btn-prev').disabled = current === 0;
        document.getElementById('btn-next').disabled = current === totalSpreads - 1;
      }
    });
    window.addEventListener('resize', () => { if (mobileQuery.matches) sizeMobilePage(); });
    if (mobileQuery.matches) document.getElementById('page-indicator').textContent = `PÁG 1 / ${mobilePages.length}`;
  });

  // Mobile probability bar animation
  const mvObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.mv-prob-fill').forEach(fill => {
          const w = fill.style.width;
          fill.style.width = '0%';
          setTimeout(() => { fill.style.width = w; }, 200);
        });
        mvObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  const mvProb = document.querySelector('.mv-prob');
  if (mvProb) mvObserver.observe(mvProb);

  // Mobile probability bars animation on scroll
  const mvProbSection = document.getElementById('mv-prob-section');
  if (mvProbSection) {
    const mvObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.mv-prob-fill').forEach(fill => {
            const w = fill.style.width;
            fill.style.width = '0%';
            setTimeout(() => { fill.style.width = w; }, 200);
          });
          mvObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    mvObserver.observe(mvProbSection);
  }


</script>

<style is:global>

  :root {
    --negro: #0a0a0a;
    --blanco: #f5f2ed;
    --celeste: #74acdf;
    --celeste-oscuro: #3a7ab5;
