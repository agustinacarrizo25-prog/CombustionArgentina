    --gris-medio: #3a3a3a;
    --gris-claro: #9a9a9a;
    --page-w: 520px;
    --page-h: 720px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #111;
    color: var(--blanco);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
