    /* ===== RESPONSIVE ===== */

  /* TABLET 600-899px: scale pages to viewport */
  @media (max-width: 899px) and (min-width: 600px) {
    :root {
      --page-w: calc((100vw - 32px) / 2);
      --page-h: calc(var(--page-w) * 1.38);
    }
    .toolbar { padding: 0 16px; }
    .toolbar-sections { display: none; }
    .stage { padding: 16px 0 40px; }
    .spread.single .page { width: calc(100vw - 32px) !important; }
    .portada-titulo { font-size: clamp(36px, 6.5vw, 60px) !important; }
    .portada-izq { padding: 20px !important; }
    .portada-izq::after { display: none; }
    .sec-title { font-size: clamp(22px, 3.5vw, 38px); }
    .cards-2x2 { grid-template-columns: 1fr; gap: 6px; }
    .fases-grid { grid-template-columns: 1fr; }
