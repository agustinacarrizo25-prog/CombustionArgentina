  .toolbar-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 20px;
    letter-spacing: 4px;
    color: var(--dorado);
  }
  .toolbar-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-btn {
    background: none;
    border: 1px solid var(--gris-medio);
    color: var(--blanco);
    width: 36px; height: 36px;
    cursor: pointer;
    font-size: 16px;
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.2s, color 0.2s;
  }
  .nav-btn:hover:not(:disabled) { border-color: var(--celeste); color: var(--celeste); }
  .nav-btn:disabled { opacity: 0.25; cursor: default; }
  .page-indicator {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--gris-claro);
    min-width: 90px;
    text-align: center;
  }
  .toolbar-sections {
    display: flex;
    gap: 20px;
    list-style: none;
  }
  .toolbar-sections button {
    background: none; border: none;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gris-claro);
    cursor: pointer;
    transition: color 0.2s;
    font-family: 'DM Sans', sans-serif;
  }
  .toolbar-sections button:hover { color: var(--celeste); }

  /* ===== MAGAZINE STAGE ===== */
  .stage {
    margin-top: 52px;
    padding: 40px 20px 60px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: calc(100vh - 52px);
  }

  /* ===== SPREAD (double page) ===== */
  .spread-wrapper {
    position: relative;
  }
  .spread {
    display: flex;
    box-shadow:
      -12px 4px 40px rgba(0,0,0,0.7),
      12px 4px 40px rgba(0,0,0,0.7),
      0 20px 60px rgba(0,0,0,0.5);
    position: relative;
  }
  /* Spine shadow */
  .spread::after {
    content: '';
    position: absolute;
    left: 50%; top: 0; bottom: 0;
    width: 6px;
    transform: translateX(-50%);
    background: linear-gradient(90deg,
      rgba(0,0,0,0.6) 0%,
      rgba(0,0,0,0.1) 40%,
      rgba(0,0,0,0.1) 60%,
      rgba(0,0,0,0.6) 100%
    );
    pointer-events: none;
    z-index: 10;
  }

  /* Single page (portada) */
  .spread.single {
    justify-content: center;
  }
  .spread.single::after { display: none; }

  /* ===== PAGE ===== */
  .page {
    width: var(--page-w);
    height: var(--page-h);
    background: var(--negro);
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }
  .page-left { border-right: 1px solid #1a1a1a; }

  /* Page number */
  .page-num {
    position: absolute;
    bottom: 14px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(245,242,237,0.25);
    z-index: 5;
  }
  .page-num-left { left: 20px; }
  .page-num-right { right: 20px; }

  /* Running header */
  .running-head {
    position: absolute;
    top: 14px;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(245,242,237,0.2);
    z-index: 5;
  }
  .running-head-left { left: 20px; }
  .running-head-right { right: 20px; }

  /* Page content area */
  .page-content {
    position: absolute;
    inset: 36px 24px 32px;
    overflow: hidden;
  }

  /* ===== SPREAD TRANSITIONS ===== */
  .spread-wrapper {
    perspective: 2400px;
    perspective-origin: center center;
    position: relative;
  }

  .spread-container {
    display: none;
    position: absolute;
    top: 0; left: 0;
  }
  .spread-container.active {
    display: block;
    position: relative;
  }

  @keyframes flipInRight {
    0%   { transform: rotateY(-22deg) translateX(40px); opacity: 0; filter: brightness(0.6); }
    100% { transform: rotateY(0deg)   translateX(0);    opacity: 1; filter: brightness(1); }
  }
  @keyframes flipInLeft {
    0%   { transform: rotateY(22deg)  translateX(-40px); opacity: 0; filter: brightness(0.6); }
    100% { transform: rotateY(0deg)   translateX(0);     opacity: 1; filter: brightness(1); }
  }
  @keyframes flipOutRight {
    0%   { transform: rotateY(0deg)   translateX(0);    opacity: 1; filter: brightness(1); }
    100% { transform: rotateY(-28deg) translateX(40px); opacity: 0; filter: brightness(0.4); }
  }
  @keyframes flipOutLeft {
    0%   { transform: rotateY(0deg)  translateX(0);     opacity: 1; filter: brightness(1); }
    100% { transform: rotateY(28deg) translateX(-40px); opacity: 0; filter: brightness(0.4); }
  }

  .spread-container.anim-in-right  .spread { animation: flipInRight  0.42s cubic-bezier(0.22,0.9,0.36,1) both; }
  .spread-container.anim-in-left   .spread { animation: flipInLeft   0.42s cubic-bezier(0.22,0.9,0.36,1) both; }
  .spread-container.anim-out-right .spread { animation: flipOutRight 0.28s cubic-bezier(0.55,0,0.8,0.45) both; }
  .spread-container.anim-out-left  .spread { animation: flipOutLeft  0.28s cubic-bezier(0.55,0,0.8,0.45) both; }

  /* ===== TYPOGRAPHY / COMPONENTS ===== */
  .bb { font-family: 'Bebas Neue', sans-serif; }
  .serif { font-family: 'DM Serif Display', serif; }

  /* Section tag */
  .sec-tag {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--celeste);
    margin-bottom: 6px;
  }
  .sec-title {
