---
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  preloadImages?: string[];
}

const {
  title = 'Combustión Argentina - La revista del automovilismo argentino',
  description = 'Revista digital de automovilismo argentino, con análisis editorial, identidad nacional y foco en la Fórmula 1.',
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/img/brand/combustion-argentina-symbol-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="/img/brand/combustion-argentina-horizontal-dark.webp" />
    {preloadImages.map((image) => <link rel="preload" as="image" href={image} />)}
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
